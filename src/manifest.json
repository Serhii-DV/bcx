{
  "manifest_version": 3,
  "name": "Bandcamp Extension (BCX)",
  "version": "0.0.0",
  "description": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://*.bandcamp.com/*"],
  "content_scripts": [
    {
      "js": ["bandcamp.content.js"],
      "matches": ["https://*.bandcamp.com/*"],
      "run_at": "document_end"
    },
    {
      "js": ["bandcamp.content.pageAlbum.js"],
      "matches": ["https://*.bandcamp.com/album/*"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bandcamp.content.css"],
      "matches": ["https://*.bandcamp.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
