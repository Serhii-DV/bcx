{
  "manifest_version": 3,
  "name": "Bandcamp Extension (BCX)",
  "version": "0.0.0",
  "description": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://*.bandcamp.com/*"],
  "content_scripts": [
    {
      "js": ["bandcamp.page.all.js"],
      "matches": ["https://*.bandcamp.com/*"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bandcamp.page.all.css",
        "bandcamp.page.music.css",
        "bandcamp.page.album.css",
        "assets/0.gif"
      ],
      "matches": ["https://*.bandcamp.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
