{
  "manifest_version": 3,
  "name": "Bandcamp Extension (BCX)",
  "version": "0.0.0",
  "description": "",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "static/js/background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "history",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": ["https://*.bandcamp.com/*"],
  "content_scripts": [
    {
      "js": ["static/js/bandcamp.content.app.js"],
      "matches": ["https://*.bandcamp.com/*"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "static/js/bcx.js",
        "static/css/bandcamp.content.app.css",
        "static/css/bandcamp.content.page.music.css",
        "assets/0.gif"
      ],
      "matches": ["https://*.bandcamp.com/*"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
